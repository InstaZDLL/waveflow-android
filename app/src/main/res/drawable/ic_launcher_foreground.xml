<?xml version="1.0" encoding="utf-8"?>
<!--
  Le logo WaveFlow : cinq barres d'égaliseur symétriques, en dégradé émeraude.
  Repris de `WaveFlow/assets/logo.svg` — mêmes proportions (140/80/40/80/140),
  mêmes couleurs — puis ramené dans la zone sûre de l'icône adaptative.

  Cette zone est un **disque** de 72 dp et non un carré : c'est la
  demi-diagonale du logo qui doit rester sous 36, pas sa demi-largeur. Dimensionné
  au carré, les deux barres extérieures tombaient hors du cercle et le premier
  lanceur rond venu les aurait rognées. À l'échelle retenue (0,30) la
  demi-diagonale vaut 34,7 dp : le logo tient, avec la marge qui va bien.

  Les barres sont des capsules : dans l'original le rayon vaut la moitié de la
  largeur, ce que des arcs de demi-cercle rendent exactement.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group>

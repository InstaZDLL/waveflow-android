            <aapt:attr name="android:fillColor">
                <gradient
                    android:startX="26.4"
                    android:startY="33"
                    android:endX="81.6"
                    android:endY="75"
                    android:type="linear">
                    <item android:offset="0" android:color="#34D399" />
                    <item android:offset="0.5" android:color="#10B981" />
                    <item android:offset="1" android:color="#059669" />
                </gradient>
            </aapt:attr>
        </path>

<?xml version="1.0" encoding="utf-8"?>
<!--
  Sauvegarde automatique, Android 11 et antérieurs.
  https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <!--
      Les jetons de session serveur ne sortent pas de l'appareil : ils sont
      stockés en clair, et un jeton de rafraîchissement restauré sur un autre
      appareil y ouvrirait le compte.
    -->
    <exclude domain="file" path="datastore/session_serveur.preferences_pb" />
</full-backup-content>

<?xml version="1.0" encoding="utf-8"?>
<!-- Le prototype WaveFlow Pocket (docs/design/sonic-editorial.md) : variante
     debug seulement. Sa propre activité et sa propre icône de lanceur, dans une
     tâche à part pour ne pas se mêler à l'application de production. Une build
     release n'en contient rien. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <activity
            android:name="app.waveflow.prototype.PocketActivity"
            android:exported="true"
            android:label="@string/pocket_name"
            android:taskAffinity="app.waveflow.pocket"
            android:theme="@style/Theme.WaveFlow"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
